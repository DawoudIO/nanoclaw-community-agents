# Not used by deploy.sh.
#
# bash nanoclaw.sh writes ~/nanoclaw/.env and asks for the Discord bot token.
# Model and GitHub credentials go into the OneCLI vault when the installer
# asks. Do not pre-create a production env file.
#
# After install, session SQLite is on the boot disk:
#   ~/nanoclaw/data/v2.db
#   ~/nanoclaw/data/v2-sessions/<agent-group>/<session>/inbound.db
#   ~/nanoclaw/data/v2-sessions/<agent-group>/<session>/outbound.db
#   ~/nanoclaw/groups/<folder>/
