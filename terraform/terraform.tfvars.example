# Copy to terraform.tfvars (gitignored) and fill from the OCI console.
# API private key and SSH key stay on disk; only paths go here.

tenancy_ocid        = "ocid1.tenancy.oc1..example"
user_ocid           = "ocid1.user.oc1..example"
fingerprint         = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path    = "/absolute/path/oci_api_key.pem"
region              = "us-ashburn-1"
compartment_ocid    = "ocid1.tenancy.oc1..example"
ssh_public_key_path = "/absolute/path/id_ed25519.pub"

# Optional. Default allows SSH from anywhere.
# ssh_ingress_cidr = "203.0.113.10/32"
# availability_domain_index = 0
